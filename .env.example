# URL base del ingest Jaiba (nombre de variable legado: DMA_JAIVA).
# No implica el lab KPI DMA_JAIVA; ese circuito es aparte (Oracle→Jaiba→Postgres DMA).
# Broder solo entrega EventEnvelope; no conoce drivers ni credenciales de DB.
DMA_JAIVA=http://127.0.0.1:19090
JAIBA_TOKEN=
JAIBA_INGEST_PATH=/api/v1/ingest/events
JAIBA_TIMEOUT_MS=2000

# Infra local opcional en docker-compose para sinks de Jaiba (make infra-up).
# No es el runtime skeleton de Broder; Jaiba es quien escribe si el DAG lo pide.
CLICKHOUSE_DATABASE=temporal
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
POSTGRES_DB=little_brother
POSTGRES_USER=little_brother
POSTGRES_PASSWORD=change-me
DB_PORT=5432

WEB_HOST=127.0.0.1
WEB_PORT=8088

# Las credenciales RTSP permanecen fuera de cameras.toml y de Git.
CAMERA_1_RTSP_URL=rtsp://usuario:contrasena@192.168.10.101:554/Streaming/Channels/101
CAMERA_2_RTSP_URL=rtsp://usuario:contrasena@192.168.10.102:554/Streaming/Channels/101
CAMERA_3_RTSP_URL=rtsp://usuario:contrasena@192.168.10.103:554/Streaming/Channels/101
