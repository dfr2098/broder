# Gateway Jaiva → ClickHouse del laboratorio DMA_JAIVA.
# En local (compose) apunta al HTTP de ClickHouse; en planta al proxy Jaiva.
DMA_JAIVA=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=temporal
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
WEB_HOST=127.0.0.1
WEB_PORT=8088

# Las credenciales RTSP permanecen fuera de cameras.toml y de Git.
CAMERA_1_RTSP_URL=rtsp://usuario:contrasena@192.168.10.101:554/Streaming/Channels/101
CAMERA_2_RTSP_URL=rtsp://usuario:contrasena@192.168.10.102:554/Streaming/Channels/101
CAMERA_3_RTSP_URL=rtsp://usuario:contrasena@192.168.10.103:554/Streaming/Channels/101
